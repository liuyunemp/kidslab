{
  "name": "kidslab",
  "version": "1.0.0",
  "private": true,
  "description": "KidsLab — K12 互动课件学习平台 / Interactive courseware platform for K12 students",
  "type": "module",
  "kidslab": {
    "analyticsEndpoint": ""
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "speech:generate": "node scripts/speech/generate.mjs",
    "speech:check": "node scripts/speech/generate.mjs --check",
    "english:sync": "node scripts/english/sync.mjs",
    "english:check": "node scripts/english/sync.mjs --check",
    "random:sync": "node scripts/random-rounds/sync.mjs && node scripts/g1b-sync.mjs",
    "random:check": "node scripts/g1b-sync.mjs --check",
    "preview": "node scripts/serve.mjs",
    "report": "node scripts/report.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:shard": "node scripts/e2e-shard.mjs",
    "test:e2e:timing": "playwright test --reporter=json --output=test-results-timing",
    "icons": "node scripts/icons.mjs",
    "vendor": "node scripts/vendor.mjs",
    "vendor:check": "node scripts/vendor.mjs --check",
    "adventure:sync": "node scripts/adventure/sync.mjs",
    "adventure:check": "node scripts/adventure/sync.mjs --check"
  },
  "license": "MIT",
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@playwright/test": "^1.61.1",
    "esbuild": "^0.28.1",
    "three": "^0.170.0"
  }
}
